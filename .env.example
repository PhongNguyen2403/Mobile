# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL - Database: Hospital_Mobile)
# Thay thế username, password và port (mặc định 5432) cho phù hợp với máy của bạn
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Hospital_Mobile?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_super_secret_access_key_min_32_characters"
JWT_REFRESH_SECRET="your_jwt_super_secret_refresh_key_min_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP Mock Config (Môi trường development: true để dùng OTP cố định 123456)
OTP_MOCK_ENABLED=true
OTP_MOCK_CODE="123456"

# Cron Settings
CRON_FOLLOW_UP_SCHEDULE="0 7 * * *" # Chạy lúc 7:00 sáng mỗi ngày
FOLLOW_UP_REMINDER_DAYS_AHEAD=3     # Nhắc lịch tái khám trước 3 ngày
